# ============================================================
# Autonomous SOC Lab - Environment Variables Template
# Copy this file: cp .env.example .env
# Then fill in your own values before running docker compose.
# NEVER commit your actual .env to version control.
# ============================================================

# ---- OpenSearch ----
OPENSEARCH_INITIAL_ADMIN_PASSWORD=change_me_strong_password
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx2g

# ---- OpenSearch Dashboards ----
OPENSEARCH_HOSTS=http://opensearch:9200

# ---- ElastAlert2 ----
ES_HOST=opensearch
ES_PORT=9200

# ---- StackStorm ----
ST2_USER=st2admin
ST2_PASSWORD=change_me_strong_password

# ---- DFIR-IRIS ----
IRIS_ADMIN_EMAIL=admin@soc.lab
IRIS_ADMIN_USERNAME=admin
IRIS_ADMIN_PASSWORD=change_me_strong_password
IRIS_SECRET_KEY=change_me_very_long_random_secret_key_here
IRIS_SECURITY_PASSWORD_SALT=change_me_very_long_random_salt_here
POSTGRES_USER=iris
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=iris_db

# ---- MISP ----
MISP_ADMIN_EMAIL=admin@soc.lab
MISP_ADMIN_PASSWORD=change_me_strong_password
MYSQL_ROOT_PASSWORD=change_me_strong_password
MYSQL_DATABASE=misp
MYSQL_USER=misp
MYSQL_PASSWORD=change_me_strong_password
MISP_BASEURL=http://localhost:8080

# ---- Velociraptor ----
VELOCIRAPTOR_ADMIN_USER=admin
VELOCIRAPTOR_ADMIN_PASSWORD=change_me_strong_password

# ---- External Integrations (optional) ----
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
IPINFO_TOKEN=your_ipinfo_token_here
IRIS_API_TOKEN=your_iris_api_token_here
VELO_API_TOKEN=your_velociraptor_api_token_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# ---- Network ----
DOCKER_SUBNET=172.20.0.0/24
