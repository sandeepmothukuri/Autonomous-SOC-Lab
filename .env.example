# ==============================================================================
# Autonomous SOC Lab — Environment Template
#
# COPY THIS FILE:
#   cp .env.example .env
# Then replace ALL <GENERATE_*> values before running `docker compose up -d`.
# NEVER commit your real .env to version control.
#
# You can generate safe random values with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# ==============================================================================

# ---- SOC response mode (simulation | approval | active) ---------------------
# simulation = log intended actions only (DEFAULT, safe)
# approval   = post actions to IRIS pending analyst sign-off
# active     = apply actions through SOAR (requires explicit opt-in and
#              real handers; do not enable until you have tested in sim)
SOC_RESPONSE_MODE=simulation

# ---- Docker networking ------------------------------------------------------
DOCKER_SUBNET=172.20.0.0/24

# ---- OpenSearch -------------------------------------------------------------
# Security plugin is DISABLED in the lab build. The password value is unused.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=<GENERATE_OPENSEARCH_PASSWORD>
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx2g

# ---- Bind addresses (default to localhost only) -----------------------------
OPENSEARCH_BIND_ADDRESS=127.0.0.1
DASHBOARDS_BIND_ADDRESS=127.0.0.1
VECTOR_BIND_ADDRESS=127.0.0.1
STACKSTORM_BIND_ADDRESS=127.0.0.1
STACKSTORM_API_BIND_ADDRESS=127.0.0.1
IRIS_BIND_ADDRESS=127.0.0.1
MISP_BIND_ADDRESS=127.0.0.1
VELOCIRAPTOR_BIND_ADDRESS=127.0.0.1
VELOCIRAPTOR_AGENT_BIND_ADDRESS=127.0.0.1
CALDERA_BIND_ADDRESS=127.0.0.1

# ---- StackStorm -------------------------------------------------------------
ST2_USER=st2admin
ST2_PASSWORD=<GENERATE_ST2_PASSWORD>

# ---- DFIR-IRIS --------------------------------------------------------------
IRIS_ADM_EMAIL=admin@soc.lab
IRIS_ADM_USERNAME=admin
IRIS_ADMIN_PASSWORD=<GENERATE_IRIS_ADMIN_PASSWORD>
IRIS_SECRET_KEY=<GENERATE_LONG_RANDOM_SECRET_64>
IRIS_SECURITY_PASSWORD_SALT=<GENERATE_LONG_RANDOM_SALT_32>
POSTGRES_USER=iris
POSTGRES_PASSWORD=<GENERATE_POSTGRES_PASSWORD>
POSTGRES_DB=iris_db

# ---- MISP -------------------------------------------------------------------
MISP_ADMIN_EMAIL=admin@soc.lab
MISP_ADMIN_PASSWORD=<GENERATE_MISP_PASSWORD>
MYSQL_ROOT_PASSWORD=<GENERATE_MYSQL_ROOT_PASSWORD>
MYSQL_USER=misp
MYSQL_PASSWORD=<GENERATE_MYSQL_PASSWORD>
MYSQL_DATABASE=misp
MISP_BASEURL=http://localhost:8080

# ---- Velociraptor -----------------------------------------------------------
VELOCIRAPTOR_ADMIN_USER=admin
VELOCIRAPTOR_ADMIN_PASSWORD=<GENERATE_VELOCIRAPTOR_PASSWORD>

# ---- MITRE Caldera ----------------------------------------------------------
# Leave blank to let Caldera generate keys on first boot.
CALDERA_API_KEY_RED=
CALDERA_API_KEY_BLUE=

# ---- External integrations (OPTIONAL) ---------------------------------------
# Leave blank to gracefully fall back to offline/simulated enrichment.
ABUSEIPDB_API_KEY=
IPINFO_TOKEN=
IRIS_API_TOKEN=
VELO_API_TOKEN=
SLACK_WEBHOOK_URL=
